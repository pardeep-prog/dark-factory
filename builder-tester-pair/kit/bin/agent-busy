#!/usr/bin/env python3
"""agent-busy — is THIS workspace's agent doing something right now? Answered from the action ledger, not from the terminal.

  agent-busy            # exit 0 + "busy: <why>" | exit 1 + "idle" | exit 2 + "unknown: <why>" (callers treat unknown as busy)

Why: the watchdog used to call an agent idle when its tmux pane had been silent for 3 minutes. A long tool call, a big build or a slow
model response prints nothing, so a schedule boundary could stop an agent in the middle of its work. The property that matters is "work in
flight", and the action ledger records it: every tool call writes an `attempt` and, when it ends, a `done` entry for the agent's role.
busy = the newest entry for this role is younger than 5 minutes, OR it is an `attempt` (a tool call that has not finished) younger than
45 minutes (a build or test battery can run that long; an older unfinished attempt means a crashed call, not work in flight).
The watchdog requires BOTH quiet pane AND this to say idle before it stops, restarts or wakes an agent."""
import datetime
import json
import os
import pathlib
import sys
import time

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[1] / "lib"))
import pairconf  # noqa: E402

QUIET_MIN, UNFINISHED_MIN = 5, 45


def newest_entry(ledger_dir, role):
    now = datetime.datetime.now(datetime.timezone.utc)
    for day in (now, now - datetime.timedelta(days=1)):
        f = pathlib.Path(ledger_dir) / f"{day:%Y-%m-%d}.jsonl"
        try:
            size = f.stat().st_size
            with open(f, "rb") as fh:
                fh.seek(max(0, size - 262144))             # the last 256 KB is plenty: entries are written every few seconds when busy
                lines = fh.read().decode("utf-8", "replace").splitlines()
        except OSError:
            continue
        for line in reversed(lines):
            try:
                r = json.loads(line)
            except ValueError:
                continue
            if r.get("agent") == role and r.get("ts"):
                return r
    return None


def main():
    try:
        cfg = pairconf.load()
        role = pairconf.role(cfg)
        ledger = pairconf.ledger_dir(cfg)
    except (Exception, SystemExit) as e:
        print(f"unknown: {type(e).__name__}")
        return 2
    r = newest_entry(ledger, role)
    if not r:
        print("idle")
        return 1
    try:
        age_min = (time.time() - datetime.datetime.strptime(r["ts"], "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=datetime.timezone.utc).timestamp()) / 60
    except ValueError:
        print("unknown: unreadable timestamp")
        return 2
    if age_min < QUIET_MIN:
        print(f"busy: last ledger entry {age_min:.1f} min ago")
        return 0
    if r.get("phase") == "attempt" and age_min < UNFINISHED_MIN:
        print(f"busy: a tool call started {age_min:.0f} min ago has not finished")
        return 0
    print("idle")
    return 1


if __name__ == "__main__":
    sys.exit(main())
